# Copy to .env for local dev (git-ignored). GitHub Actions gets these from repo Secrets instead.

ANTHROPIC_API_KEY=
# PAT scoped to Issues read/write ONLY on the demo repo (not a full-access token).
TRIAGE_GITHUB_TOKEN=
# owner/repo of the demo repo the agent acts on.
TRIAGE_REPO=rakeshsabbisetty2001/issue-triage-demo
# Pinned model ID — never left to an SDK default (cost/latency/eval reproducibility depend on it).
CLAUDE_MODEL=claude-sonnet-5
# true = log intended actions, never call the GitHub write API. Must be explicitly "false" for real runs.
DRY_RUN=true
MAX_ISSUES_PER_RUN=15
